{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "if": "Write(*.test.*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.mjs\""
          },
          {
            "type": "command",
            "if": "Edit(*.test.*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.mjs\""
          },
          {
            "type": "command",
            "if": "Write(*.spec.*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.mjs\""
          },
          {
            "type": "command",
            "if": "Edit(*.spec.*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.mjs\""
          },
          {
            "type": "command",
            "if": "Write(**/tests/**)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.mjs\""
          },
          {
            "type": "command",
            "if": "Edit(**/tests/**)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.mjs\""
          },
          {
            "type": "command",
            "if": "Write(**/__tests__/**)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.mjs\""
          },
          {
            "type": "command",
            "if": "Edit(**/__tests__/**)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.mjs\""
          },
          {
            "type": "command",
            "if": "Write(**/e2e/**)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.mjs\""
          },
          {
            "type": "command",
            "if": "Edit(**/e2e/**)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.mjs\""
          },
          {
            "type": "command",
            "if": "Write(**/fixtures/**)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.mjs\""
          },
          {
            "type": "command",
            "if": "Edit(**/fixtures/**)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.mjs\""
          },
          {
            "type": "command",
            "if": "Write(*vitest.config*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.mjs\""
          },
          {
            "type": "command",
            "if": "Edit(*vitest.config*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.mjs\""
          },
          {
            "type": "command",
            "if": "Write(*playwright.config*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.mjs\""
          },
          {
            "type": "command",
            "if": "Edit(*playwright.config*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.mjs\""
          },
          {
            "type": "command",
            "if": "Write(*jest.config*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.mjs\""
          },
          {
            "type": "command",
            "if": "Edit(*jest.config*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.mjs\""
          },
          {
            "type": "command",
            "if": "Write(*.py)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.mjs\""
          },
          {
            "type": "command",
            "if": "Edit(*.py)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.mjs\""
          },
          {
            "type": "command",
            "if": "Write(*.sh)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.mjs\""
          },
          {
            "type": "command",
            "if": "Edit(*.sh)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*bun test*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.mjs\""
          },
          {
            "type": "command",
            "if": "Bash(*bun run test*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.mjs\""
          },
          {
            "type": "command",
            "if": "Bash(*npm run test*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.mjs\""
          },
          {
            "type": "command",
            "if": "Bash(*vitest*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.mjs\""
          },
          {
            "type": "command",
            "if": "Bash(*playwright*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.mjs\""
          },
          {
            "type": "command",
            "if": "Bash(*jest*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.mjs\""
          },
          {
            "type": "command",
            "if": "Bash(*phpunit*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.mjs\""
          },
          {
            "type": "command",
            "if": "Bash(*.test.*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.mjs\""
          },
          {
            "type": "command",
            "if": "Bash(*.spec.*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.mjs\""
          },
          {
            "type": "command",
            "if": "Bash(*tests/*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.mjs\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.mjs\""
          }
        ]
      }
    ]
  }
}
